#!/usr/bin/env bash
# A browser this skill drives, reached one of two ways.
#
#   browse start                  # start a browser of ours, and remember it
#   browse attach [port]          # drive the browser the user already runs
#   browse stop                   # stop ours; an attached one is left alone
#   browse status                 # is it up, on which port, and whose
#   browse doctor                 # can this machine drive a browser at all
#
# `start` keeps one long-lived Edge with its own profile. A second
# --remote-debugging-port against a profile that is already open does not listen:
# the running browser swallows the request and the new port stays dead. So the
# instance this skill starts is the only one with that profile, and it is started
# with the port from the beginning.
#
# `attach` is the way to a browser that is the user's: since Chromium 136 the port
# flag is ignored on a real user profile (a cookie-theft fix -- the process starts,
# the port never opens), so the only door left is Chromium's own switch at
# edge://inspect/#remote-debugging, which opens CDP on port 9222 with the human's
# consent. Nothing here starts, copies or stops that browser.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

HOME_DIR="${BROWSER_HOME:-$HOME/.agents/browser}"
PROFILE="${BROWSER_PROFILE:-$HOME_DIR/profile}"
PORT_FILE="$HOME_DIR/port"
PID_FILE="$HOME_DIR/edge.pid"
LOG_FILE="$HOME_DIR/edge.log"
# Whose browser the recorded port belongs to: "own" when `start` launched it,
# "attached" when the user's own browser is being driven. `stop` decides by it.
MODE_FILE="$HOME_DIR/mode"

die() { printf '%s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

# Whose browser the recorded port is: `own` unless `attach` said otherwise.
mode() {
  local value=""
  [[ -f "$MODE_FILE" ]] && value=$(tr -d '\r\n' <"$MODE_FILE")
  printf '%s' "${value:-own}"
}

# Where Edge is. The Playwright-managed chromium is the fallback: it speaks the
# same protocol, and a machine without Edge still gets a browser.
find_edge() {
  local candidates=(
    "/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
    "/c/Program Files/Microsoft/Edge/Application/msedge.exe"
  )
  local exe
  for exe in "${candidates[@]}"; do
    [[ -f "$exe" ]] && { printf '%s' "$exe"; return 0; }
  done
  # The Playwright chromium, if it is on this machine.
  local chromium
  chromium=$(ls -d "$HOME"/AppData/Local/ms-playwright/chromium-*/chrome-win64/chrome.exe 2>/dev/null | sort -V | tail -n1)
  [[ -n "$chromium" ]] && { printf '%s' "$chromium"; return 0; }
  return 1
}

port_open() {
  local port=$1
  python - "$port" <<'PY' 2>/dev/null
import socket, sys
try:
    socket.create_connection(("127.0.0.1", int(sys.argv[1])), 1).close()
except Exception:
    sys.exit(1)
PY
}

# The browser that answers on this port, or nothing.
browser_version() {
  local port=$1
  python - "$port" <<'PY' 2>/dev/null
import json, sys, urllib.request
try:
    data = json.load(urllib.request.urlopen("http://127.0.0.1:%s/json/version" % sys.argv[1], timeout=2))
except Exception:
    sys.exit(1)
print(data.get("Browser", "?"))
PY
}

free_port() {
  python - <<'PY'
import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
PY
}

do_start() {
  local exe
  exe=$(find_edge) || die "no browser found: install Edge, or run 'playwright install chromium'"
  mkdir -p "$HOME_DIR" "$PROFILE"

  # Headless unless asked otherwise: a window on the user's desktop is an
  # interruption, and everything this skill does -- text, links, cookies,
  # screenshots -- works the same without one. `--headed` opens the window for
  # the times a human wants to watch or log in.
  local headless="--headless=new"
  [[ "${BROWSER_HEADED:-0}" == "1" ]] && headless=""

  # One port at a time: `attach` and `start` never both hold a browser, so a
  # verb is unambiguous about whose browser it drives.
  if [[ "$(mode)" == "attached" && -f "$PORT_FILE" ]]; then
    say "attached to the browser on port $(cat "$PORT_FILE"); 'browse stop' releases it first"
    return 1
  fi

  # An instance that is already up on our port is the one we want.
  if [[ -f "$PORT_FILE" ]] && port_open "$(cat "$PORT_FILE")"; then
    say "already up: $(browser_version "$(cat "$PORT_FILE")") on port $(cat "$PORT_FILE")"
    return 0
  fi

  # A browser of ours may already be running on another port: a second one with
  # the same profile does not start at all, the running one swallows the
  # request. So the existing one is found and used.
  local existing
  existing=$(our_pid)
  if [[ -n "$existing" ]]; then
    local port
    port=$(port_of_pid "$existing")
    if [[ -n "$port" ]]; then
      printf '%s\n' "$port" >"$PORT_FILE"
      say "already up: $(browser_version "$port") on port $port"
      return 0
    fi
  fi

  local port
  port=$(free_port)
  local native_profile
  native_profile=$(cygpath -w "$PROFILE" 2>/dev/null || printf '%s' "$PROFILE")

  # A windows process needs a windows path; a shell needs a posix one.
  "$exe" --remote-debugging-port="$port" \
          --user-data-dir="$native_profile" \
          $headless \
          --no-first-run --no-default-browser-check \
          about:blank >"$LOG_FILE" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" >"$PID_FILE"

  # Ready means the browser answered, not that the port was opened: the process
  # takes seconds to get there, and a refused connection in between is normal.
  local waited=0
  while (( waited < 60 )); do
    if port_open "$port"; then
      printf '%s\n' "$port" >"$PORT_FILE"
      printf 'own\n' >"$MODE_FILE"
      say "started: $(browser_version "$port") on port $port"
      say "profile: $PROFILE"
      return 0
    fi
    sleep 1
    waited=$(( waited + 1 ))
  done
  say "the browser did not answer on port $port after ${waited}s; log: $LOG_FILE"
  # The process can be up with the port dead: since Chromium 136 the port flag is
  # ignored when the profile is a real user profile, which is a silent refusal.
  if [[ -n "$(our_pid)" ]]; then
    say "the browser is running but its debugging port never opened."
    say "if that profile is one a person uses, Chromium 136+ ignores the port flag there:"
    say "  enable edge://inspect/#remote-debugging in that browser, then 'browse attach'"
  fi
  return 1
}

do_stop() {
  local stopped=0
  if [[ -f "$PORT_FILE" ]]; then
    local port pid
    port=$(cat "$PORT_FILE")
    # An attached browser is the user's: this releases the connection and leaves
    # the process alone, whatever its command line says.
    if [[ "$(mode)" == "attached" ]]; then
      say "released the browser on port $port; it is yours, so it keeps running"
      rm -f "$PORT_FILE" "$PID_FILE" "$MODE_FILE"
      return 0
    fi
    pid=$(port_owner_pid "$port")
    if [[ -n "$pid" ]] && owns_profile "$pid"; then
      # Only the process that is this skill's browser: its command line names
      # this skill's profile directory. A browser the user started has neither.
      taskkill //PID "$pid" //T //F >/dev/null 2>&1 && stopped=1
      say "stopped the browser on port $port"
    elif [[ -n "$pid" ]]; then
      say "port $port belongs to a browser that is not ours; it stays"
    else
      say "no browser on port $port"
    fi
    rm -f "$PORT_FILE" "$PID_FILE" "$MODE_FILE"
  else
    rm -f "$PID_FILE" "$MODE_FILE"
  fi
  (( stopped )) || say "nothing of ours was running"
  return 0
}

# Drive the browser the user already runs, through Chromium's own consent switch.
#
# This is the only way to CDP a real user profile: since Chromium 136 the
# --remote-debugging-port flag is ignored when the data directory is a person's
# own, and the refusal is silent -- the browser starts and the port never opens.
# edge://inspect/#remote-debugging opens CDP on a port instead, by the human's
# consent, and that server answers on the websocket without HTTP discovery.
do_attach() {
  local port="${1:-9222}"
  local current
  current=$(cat "$PORT_FILE" 2>/dev/null)
  if [[ "$current" == "$port" ]] && [[ "$(mode)" == "attached" ]] && port_open "$port"; then
    say "already attached: port $port"
    return 0
  fi
  local waited=0
  while (( waited < 2 )); do
    port_open "$port" && break
    sleep 1
    waited=$(( waited + 1 ))
  done
  if ! port_open "$port"; then
    say "nothing answers on port $port."
    say "In the browser you want driven, open edge://inspect/#remote-debugging and tick"
    say "  \"Allow remote debugging for this browser instance\","
    say "then run 'browse attach' again and answer Allow on the prompt."
    say "Chromium 136+ ignores --remote-debugging-port on a real user profile, so this"
    say "switch -- not a restart with a flag -- is the door."
    return 1
  fi
  mkdir -p "$HOME_DIR"
  printf '%s\n' "$port" >"$PORT_FILE"
  printf 'attached\n' >"$MODE_FILE"
  rm -f "$PID_FILE"
  say "attached: port $port (a browser this skill did not start)"
  return 0
}

# The debugging port a pid was started with.
port_of_pid() {
  local pid=$1
  local command
  command=$(powershell -NoProfile -Command \
    "(Get-CimInstance Win32_Process -Filter 'ProcessId=$pid').CommandLine" 2>/dev/null | tr -d '\r')
  [[ "$command" =~ --remote-debugging-port=([0-9]+) ]] && printf '%s' "${BASH_REMATCH[1]}"
}

# The windows pid that listens on a port.
port_owner_pid() {
  local port=$1
  netstat -ano 2>/dev/null | awk -v p=":$port" '$2 ~ p"$" && $4 == "LISTENING" { print $5; exit }'
}

# Whether that pid's command line names this skill's profile: the only way to
# tell our browser from the one the user started. The command line carries the
# native spelling, so both spellings are checked.
owns_profile() {
  local pid=$1
  local command native
  command=$(powershell -NoProfile -Command \
    "(Get-CimInstance Win32_Process -Filter 'ProcessId=$pid').CommandLine" 2>/dev/null | tr -d '\r')
  [[ -n "$command" ]] || return 1
  native=$(cygpath -w "$PROFILE" 2>/dev/null || printf '%s' "$PROFILE")
  [[ "$command" == *"$native"* || "$command" == *"$PROFILE"* ]]
}

# The pid of our own browser, if it is running: matched by the profile, never by
# the image name -- several browsers on this machine share that name.
our_pid() {
  local native
  native=$(cygpath -w "$PROFILE" 2>/dev/null || printf '%s' "$PROFILE")
  powershell -NoProfile -Command \
    "Get-CimInstance Win32_Process -Filter \"Name='msedge.exe'\" | Where-Object { \$_.CommandLine -like '*$native*' -and \$_.CommandLine -like '*--remote-debugging-port=*' } | Select-Object -First 1 -ExpandProperty ProcessId" \
    2>/dev/null | tr -d '\r' | head -n1
}

do_status() {
  if [[ -f "$PORT_FILE" ]]; then
    local port
    port=$(cat "$PORT_FILE")
    if port_open "$port"; then
      if [[ "$(mode)" == "attached" ]]; then
        say "up: attached to port $port (a browser this skill did not start)"
      else
        say "up: $(browser_version "$port") on port $port"
        say "profile: $PROFILE"
      fi
      return 0
    fi
    say "the recorded port $port is dead; the browser is gone"
    return 1
  fi
  say "not started"
  return 1
}

do_doctor() {
  local exe
  if exe=$(find_edge); then
    say "ok   browser: $exe"
  else
    say "FAIL no browser: install Edge, or run 'playwright install chromium'"
    return 1
  fi
  if command -v uv >/dev/null 2>&1; then
    say "ok   uv: $(command -v uv)"
  else
    say "FAIL no uv; the driver needs 'uv run --with playwright'"
    return 1
  fi
  if [[ -f "$PORT_FILE" ]] && port_open "$(cat "$PORT_FILE")"; then
    say "ok   running: $(browser_version "$(cat "$PORT_FILE")")"
  else
    say "note not running; 'browse start' brings it up"
  fi
  # A browser the user runs is reachable only through its own consent switch, so
  # whether that switch is on is part of "can this machine be driven at all".
  if port_open "${BROWSER_ATTACH_PORT:-9222}"; then
    say "ok   attachable: something listens on ${BROWSER_ATTACH_PORT:-9222} (edge://inspect/#remote-debugging)"
  else
    say "note nothing on ${BROWSER_ATTACH_PORT:-9222}; for your own browser tick edge://inspect/#remote-debugging, then 'browse attach'"
  fi
  return 0
}

case "${1:-}" in
  start) do_start ;;
  attach) do_attach "${2:-}" ;;
  stop) do_stop ;;
  status) do_status ;;
  doctor) do_doctor ;;
  "")
    say "usage: browse {start|attach [port]|stop|status|doctor}"
    say "       browse <action> ...   # open text html click type press shot cookies tabs find"
    exit 2
    ;;
  *)
    # Anything else is an action on the browser: the driver connects to the port
    # `browse start` recorded. It runs the same python the machine has, with the
    # dependency uv resolves.
    if ! command -v uv >/dev/null 2>&1; then
      die "no uv; install it from https://docs.astral.sh/uv/"
    fi
    exec uv run --quiet "$here/browse.py" "$@"
    ;;
esac
